<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <!-- 保留 nlog 區塊：NLog.config 已被引用，這裡只是讓 NLog 從外部檔讀取 -->
    <section name="nlog" type="NLog.Config.ConfigSectionHandler, NLog" allowLocation="true" allowDefinition="Everywhere" />
  </configSections>
  <nlog configSource="NLog.config" />

  <appSettings>
    <!-- LicenseKeyVandor : 1:Taiwan、2:China-->
    <add key="LicenseKeyVandor" value="1" />
    <add key="BC_ID" value="OHT" />
    <add key="NatsURL" value="127.0.0.1" />
    <add key="WebAPIURL" value="127.0.0.1:3275" />
    <add key="CsvConfig" value="\Config\" />
    <add key="ClientSettingsProvider.ServiceUri" value="" />

    <!-- Section 切割長度 -->
    <add key="SecCutLength" value="600" />
    <!-- 車輛長度 -->
    <add key="VehicleLength" value="800" />
    <!-- 車輛 + Sensor 長度 -->
    <add key="VehicleSensorLength" value="1960" />
    <!-- 直線判斷容許誤差 -->
    <add key="SecStraightBuffer" value="100" />

    <!-- 模擬運作時間設定 -->
    <add key="Move_Step_Time" value="200" />
    <add key="Report_136_Step_Time" value="500" />
    <add key="BCRRead_Time" value="2000" />
    <add key="LoadArrival_To_Loading_Time" value="2000" />
    <add key="Loading_To_LoadComplete_Time" value="2000" />
    <add key="UnloadArrival_To_Unloading_Time" value="2000" />
    <add key="Unloading_To_UnloadComplete_Time" value="2000" />

    <!-- 定時上報時間間隔 -->
    <add key="Report_144_Time" value="60000" />
    <add key="Report_134_Time" value="500" />
    <add key="SendS1F3_Time" value="600000" />

    <!-- 自動命令設定 -->
    <add key="Command_Count" value="10" />
    <add key="Command_Intrerval" value="10000" />

    <!-- SECS Setting -->
    <add key="SECSLocalIP" value="192.168.170.80" />
    <add key="SECSRemoteIP" value="192.168.170.80" />
    <add key="SECSLocalPort" value="5012" />
    <add key="SECSRemotePort" value="5011" />

    <!-- GRPC Timeout Time(秒) -->
    <add key="GrpcTimeoutTime" value="30" />

    <!-- 是否使用準確停車位置 (移動較慢) Y:啟用 N:停用 -->
    <add key="PrecisePark" value="Y" />

    <!-- ID27/127 Parameters Settings -->
    <add key="StraightSpeedSetting" value="3000" />
    <add key="RTrackSpeedSetting" value="1000" />
    <add key="UTrackSpeedSetting" value="1000" />
    <add key="STrackSpeedSetting" value="1000" />
    <add key="PIOOnOffState" value="ON" />
    <add key="BCROnOffState" value="ON" />
    <add key="CarrierSupportType" value="1" />
  </appSettings>
</configuration>
