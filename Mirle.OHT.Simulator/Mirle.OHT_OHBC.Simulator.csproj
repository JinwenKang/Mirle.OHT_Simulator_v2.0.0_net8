<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Mirle.Agvc.Simulator</AssemblyName>
    <RootNamespace>Mirle.Agvc.Simulator</RootNamespace>
    <ApplicationIcon>模擬器 (1).ico</ApplicationIcon>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!--
      x86 強制：
      1. QS ActiveX COM 元件 (CLSID 6FF9C8F2-...) 只註冊在 32-bit registry hive
      2. hasp_net_windows.dll 是 i386 (x86) .NET 組件
      3. SECSTrxControl 系列廠商 DLL 全為 32-bit 設計
      .NET 4.x AnyCPU 預設 Prefer32Bit 跑 32-bit；.NET 8 移除此旗標必須顯式 x86
    -->
    <PlatformTarget>x86</PlatformTarget>
    <Deterministic>true</Deterministic>
    <!-- 組件中繼資料：原 Properties/AssemblyInfo.cs 內容收進來，SDK 自動產生 -->
    <AssemblyTitle>Mirle.Agvc.Simulator</AssemblyTitle>
    <Product>Mirle.Agvc.Simulator</Product>
    <Company>Mirle Automation Corporation</Company>
    <Copyright>Copyright © Mirle Automation Corporation</Copyright>
    <AssemblyVersion>2.0.0.14</AssemblyVersion>
    <FileVersion>2.0.0.14</FileVersion>
    <Version>2.0.0.14</Version>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- WinForms 在 net8.0-windows 下會大量觸發 CA1416；TFM 已限定 Windows，可安全抑制 -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <!-- 排除沒在用的舊範本目錄與歷史備份輸出 -->
  <ItemGroup>
    <Compile Remove="GrpcDemo\**" />
    <None Remove="GrpcDemo\**" />
    <EmbeddedResource Remove="GrpcDemo\**" />
    <Content Remove="GrpcDemo\**" />
  </ItemGroup>

  <!-- NuGet 套件 -->
  <ItemGroup>
    <PackageReference Include="Elasticsearch.Net" Version="7.17.5" />
    <PackageReference Include="NEST" Version="7.17.5" />
    <PackageReference Include="Google.Protobuf" Version="3.25.1" />
    <PackageReference Include="Grpc.Core" Version="2.46.6" />
    <PackageReference Include="Grpc.Core.Api" Version="2.46.6" />
    <PackageReference Include="NLog" Version="5.3.4" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.0" />
  </ItemGroup>

  <!--
    本地 DLL 參考
    - SECSTrxControl 內部 binary 引用 hasp_net_windows，雖然 .cs 沒 using，但執行期會載入
    - hasp_net_windows 又需要 native helper（hasp_windows_*.dll / apidsp_windows*.dll，由加密狗驅動提供）
      若執行期出現「無法呼叫 HASP」可再把那些 native dll 放回 bin\Release 並加入 Content。
  -->
  <ItemGroup>
    <Reference Include="GenericParsing">
      <HintPath>DLL\GenericParsing.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="SECSTrxControl">
      <HintPath>DLL\SECSTrxControl.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="TCPIPTrxControl">
      <HintPath>DLL\TCPIPTrxControl.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="hasp_net_windows">
      <HintPath>DLL\hasp_net_windows.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <!-- 專案參考 -->
  <ItemGroup>
    <ProjectReference Include="..\CommonMessage\CommonMessage.csproj" />
  </ItemGroup>

  <!-- 設定檔複製 (Config / SaveConfig CSV、Log.ini、NLog.config、路徑 XML、AsServer.7z、TCPIPTrxControl.dll.config) -->
  <ItemGroup>
    <None Update="AsServer.7z" CopyToOutputDirectory="Always" />
    <None Update="Log.ini" CopyToOutputDirectory="Always" />
    <None Update="NLog.config" CopyToOutputDirectory="Always" />
    <None Update="DLL\TCPIPTrxControl.dll.config" CopyToOutputDirectory="Always" />

    <None Update="AtoA.xml" CopyToOutputDirectory="Always" />
    <None Update="AtoB.xml" CopyToOutputDirectory="Always" />
    <None Update="AtoG.xml" CopyToOutputDirectory="Always" />
    <None Update="BtoA.xml" CopyToOutputDirectory="Always" />
    <None Update="BtoB.xml" CopyToOutputDirectory="Always" />
    <None Update="BtoG.xml" CopyToOutputDirectory="Always" />
    <None Update="GtoA.xml" CopyToOutputDirectory="Always" />
    <None Update="GtoB.xml" CopyToOutputDirectory="Always" />
    <None Update="GtoG.xml" CopyToOutputDirectory="Always" />

    <None Update="Config\**\*.csv" CopyToOutputDirectory="Always" />
    <None Update="SaveConfig\**\*.csv" CopyToOutputDirectory="Always" />
  </ItemGroup>

  <!-- HASP 加密狗 native runtime（hasp_net_windows.dll 透過 P/Invoke 載入）-->
  <ItemGroup>
    <Content Include="hasp_windows_101490.dll" CopyToOutputDirectory="Always" />
    <Content Include="hasp_windows_24266.dll" CopyToOutputDirectory="Always" />
    <Content Include="hasp_windows_x64_101490.dll" CopyToOutputDirectory="Always" />
    <Content Include="hasp_windows_x64_24266.dll" CopyToOutputDirectory="Always" />
    <Content Include="apidsp_windows.dll" CopyToOutputDirectory="Always" />
    <Content Include="apidsp_windows_x64.dll" CopyToOutputDirectory="Always" />
  </ItemGroup>

</Project>
