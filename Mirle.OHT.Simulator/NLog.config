<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      throwExceptions="false"
      internalLogLevel="Off">

  <!--
    優化要點：
    1. 全部 File target 用 AsyncWrapper 包，主執行緒不被磁碟 I/O 阻塞
    2. keepFileOpen=true、concurrentWrites=false 省掉每次寫入的 open/close 與檔鎖
    3. Error / HasError autoFlush=true，程式 crash 時錯誤一定落地
    4. layout 中 exception 只在 message 後輸出一次（原本前後各一次會印兩次）
    5. ${date} cached，高頻 log 不再每筆重算日期字串
    6. OHTC fileName 修正：原本和 TcpIpTrxState 撞檔
    7. 高頻 Debug log 用 Discard，避免拖垮主執行緒；Error 類用 Block 不丟資料
  -->

  <variable name="logDirectory" value="D:\OHTC_Sim_Log\${cached:cached=true:inner=${date:format=yyyyMMdd}:cacheKey=${date:format=yyyyMMdd}}" />
  <variable name="layoutDF"
            value="[${date:format=yyyy-MM-dd HH\:mm\:ss.fff} ${logger} ${level:uppercase=true}]: ${message}${onexception:inner=${newline}${exception:format=ToString}}" />

  <targets>

    <!-- ============ Error (autoFlush) ============ -->
    <target name="Error" xsi:type="AsyncWrapper"
            queueLimit="10000" batchSize="200" overflowAction="Block" timeToSleepBetweenBatches="0">
      <target xsi:type="File"
              fileName="${logDirectory}/Error.log"
              archiveFileName="${logDirectory}/Archive/Error_{#}.log"
              maxArchiveFiles="10" archiveNumbering="Date" archiveEvery="Day"
              keepFileOpen="true" concurrentWrites="false"
              autoFlush="true"
              encoding="utf-8"
              layout="${layoutDF}" />
    </target>

    <target name="HasError" xsi:type="AsyncWrapper"
            queueLimit="10000" batchSize="200" overflowAction="Block">
      <target xsi:type="File"
              fileName="${logDirectory}/HasError.log"
              archiveFileName="${logDirectory}/Archive/HasError_{#}.log"
              maxArchiveFiles="10" archiveNumbering="Date" archiveEvery="Day"
              keepFileOpen="true" concurrentWrites="false"
              autoFlush="true"
              encoding="utf-8"
              layout="${layoutDF}" />
    </target>

    <!-- ============ gRPC ============ -->
    <target name="gRPC_ConnectionRecord" xsi:type="AsyncWrapper"
            queueLimit="20000" batchSize="500" overflowAction="Discard">
      <target xsi:type="File"
              fileName="${logDirectory}/gRPC_ConnectionRecord.log"
              archiveFileName="${logDirectory}/Archive/gRPC_ConnectionRecord_${date:format=yyyy-MM-dd}_{##}.log"
              archiveAboveSize="20240000" maxArchiveFiles="120" archiveNumbering="Sequence"
              keepFileOpen="true" concurrentWrites="false"
              encoding="utf-8"
              layout="${layoutDF}" />
    </target>

    <!-- ============ Road / OHTC ============ -->
    <target name="RoadControl" xsi:type="AsyncWrapper"
            queueLimit="20000" batchSize="500" overflowAction="Discard">
      <target xsi:type="File"
              fileName="${logDirectory}/RoadControl.log"
              archiveFileName="${logDirectory}/Archive/RoadControl_${date:format=yyyy-MM-dd}_{##}.log"
              archiveAboveSize="20240000" maxArchiveFiles="120" archiveNumbering="Sequence"
              keepFileOpen="true" concurrentWrites="false"
              encoding="utf-8"
              layout="${layoutDF}" />
    </target>

    <target name="OHTC" xsi:type="AsyncWrapper"
            queueLimit="10000" batchSize="200" overflowAction="Block">
      <target xsi:type="File"
              fileName="${logDirectory}/OHTC.log"
              archiveFileName="${logDirectory}/Archive/OHTC_{#}.log"
              maxArchiveFiles="60" archiveNumbering="Date" archiveEvery="Day"
              keepFileOpen="true" concurrentWrites="false"
              autoFlush="true"
              encoding="utf-8"
              layout="${layoutDF}" />
    </target>

    <!-- ============ SECS Family ============ -->
    <target name="SECSCmd" xsi:type="AsyncWrapper"
            queueLimit="20000" batchSize="500" overflowAction="Discard">
      <target xsi:type="File"
              fileName="${logDirectory}/SECSCmd.log"
              archiveFileName="${logDirectory}/Archive/SECSCmd_{#}.log"
              maxArchiveFiles="10" archiveNumbering="Date" archiveEvery="Day"
              keepFileOpen="true" concurrentWrites="false"
              encoding="utf-8"
              layout="${layoutDF}" />
    </target>

    <target name="SXFYConvertLogger" xsi:type="AsyncWrapper"
            queueLimit="20000" batchSize="500" overflowAction="Discard">
      <target xsi:type="File"
              fileName="${logDirectory}/SXFYConvertLogger.log"
              archiveFileName="${logDirectory}/Archive/SXFYConvertLogger_{#}.log"
              maxArchiveFiles="10" archiveNumbering="Date" archiveEvery="Day"
              keepFileOpen="true" concurrentWrites="false"
              encoding="utf-8"
              layout="${layoutDF}" />
    </target>

    <target name="SECSTrxLogger" xsi:type="AsyncWrapper"
            queueLimit="20000" batchSize="500" overflowAction="Discard">
      <target xsi:type="File"
              fileName="${logDirectory}/SECSTrxLogger.log"
              archiveFileName="${logDirectory}/Archive/SECSTrxLogger_{#}.log"
              maxArchiveFiles="10" archiveNumbering="Date" archiveEvery="Day"
              keepFileOpen="true" concurrentWrites="false"
              encoding="utf-8"
              layout="${layoutDF}" />
    </target>

    <target name="SXFYLogger" xsi:type="AsyncWrapper"
            queueLimit="20000" batchSize="500" overflowAction="Discard">
      <target xsi:type="File"
              fileName="${logDirectory}/SXFYLogger.log"
              archiveFileName="${logDirectory}/Archive/SXFYLogger_{#}.log"
              maxArchiveFiles="10" archiveNumbering="Date" archiveEvery="Day"
              keepFileOpen="true" concurrentWrites="false"
              encoding="utf-8"
              layout="${layoutDF}" />
    </target>

    <target name="SECSMsgLogger" xsi:type="AsyncWrapper"
            queueLimit="20000" batchSize="500" overflowAction="Discard">
      <target xsi:type="File"
              fileName="${logDirectory}/SECSMsgLogger.log"
              archiveFileName="${logDirectory}/Archive/SECSMsgLogger_{#}.log"
              maxArchiveFiles="10" archiveNumbering="Date" archiveEvery="Day"
              keepFileOpen="true" concurrentWrites="false"
              encoding="utf-8"
              layout="${layoutDF}" />
    </target>

    <!-- ============ TCP/IP ============ -->
    <target name="TcpIpControl" xsi:type="AsyncWrapper"
            queueLimit="20000" batchSize="500" overflowAction="Discard">
      <target xsi:type="File"
              fileName="${logDirectory}/TcpIpControl.log"
              archiveFileName="${logDirectory}/Archive/TcpIpControl_{#}.log"
              maxArchiveFiles="10" archiveNumbering="Date" archiveEvery="Day"
              keepFileOpen="true" concurrentWrites="false"
              encoding="utf-8"
              layout="${layoutDF}" />
    </target>

    <target name="TcpIpTrx" xsi:type="AsyncWrapper"
            queueLimit="20000" batchSize="500" overflowAction="Discard">
      <target xsi:type="File"
              fileName="${logDirectory}/TcpIpTrx.log"
              archiveFileName="${logDirectory}/Archive/TcpIpTrx_{#}.log"
              maxArchiveFiles="10" archiveNumbering="Date" archiveEvery="Day"
              keepFileOpen="true" concurrentWrites="false"
              encoding="utf-8"
              layout="${layoutDF}" />
    </target>

    <target name="TcpIpTrxState" xsi:type="AsyncWrapper"
            queueLimit="20000" batchSize="500" overflowAction="Discard">
      <target xsi:type="File"
              fileName="${logDirectory}/TcpIpTrxState.log"
              archiveFileName="${logDirectory}/Archive/TcpIpTrxState_{#}.log"
              maxArchiveFiles="10" archiveNumbering="Date" archiveEvery="Day"
              keepFileOpen="true" concurrentWrites="false"
              encoding="utf-8"
              layout="${layoutDF}" />
    </target>

    <!-- ============ Misc ============ -->
    <target name="SystemProcess" xsi:type="AsyncWrapper"
            queueLimit="20000" batchSize="500" overflowAction="Discard">
      <target xsi:type="File"
              fileName="${logDirectory}/SystemProcess.log"
              archiveFileName="${logDirectory}/Archive/SystemProcess_{#}.log"
              maxArchiveFiles="10" archiveNumbering="Date" archiveEvery="Day"
              keepFileOpen="true" concurrentWrites="false"
              encoding="utf-8"
              layout="${layoutDF}" />
    </target>

  </targets>

  <rules>
    <logger name="*"                     minlevel="Error" writeTo="Error" />
    <logger name="HasError"              minlevel="Info"  writeTo="HasError"            final="true" />
    <logger name="gRPC_ConnectionRecord" minlevel="Warn"  writeTo="gRPC_ConnectionRecord" final="true" />
    <logger name="RoadControl"           minlevel="Info"  writeTo="RoadControl" />
    <logger name="SECSCmd"               minlevel="Info"  writeTo="SECSCmd" />
    <logger name="TcpIpControl"          minlevel="Debug" writeTo="TcpIpControl" />
    <logger name="TcpIpTrx"              minlevel="Debug" writeTo="TcpIpTrx" />
    <logger name="TcpIpTrxState"         minlevel="Debug" writeTo="TcpIpTrxState" />
    <logger name="OHTC"                  minlevel="Error" writeTo="OHTC" />
    <logger name="SXFYConvertLogger"     minlevel="Info"  writeTo="SXFYConvertLogger"   final="true" />
    <logger name="SECSTrxLogger"         minlevel="Info"  writeTo="SECSTrxLogger"       final="true" />
    <logger name="SXFYLogger"            minlevel="Info"  writeTo="SXFYLogger"          final="true" />
    <logger name="SECSMsgLogger"         minlevel="Info"  writeTo="SECSMsgLogger"       final="true" />
    <logger name="SystemProcess"         minlevel="Info"  writeTo="SystemProcess"       final="true" />
  </rules>
</nlog>
